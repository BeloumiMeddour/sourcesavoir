generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}


model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String   @default("user")
  nom       String?  // Optionnel
  prenom    String?  // Optionnel
  createdAt DateTime @default(now())
}

// Catalogue des cours
model Cours {
  id              Int                @id @default(autoincrement())
  code            String             @unique
  nom             String
  duree           Int
  programme       String
  etapeEtude      String
  typeSalle       String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  affectations    AffectationCours[] // Cours planifiés
}

model Salle {
  id              Int                @id @default(autoincrement())
  code            String             @unique
  type            String
  capacite        Int
  createdAt       DateTime           @default(now())
  disponibilites  Disponibilite[]
  affectations    AffectationCours[]
}

model Professeur {
  id              Int                @id @default(autoincrement())
  matricule       String             @unique
  nom             String
  prenom          String
  specialite      String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  disponibilites  Disponibilite[]
  affectations    AffectationCours[]
}

model Disponibilite {
  id              Int         @id @default(autoincrement())
  jour            String      // Lundi, Mardi, etc.
  plageHoraire    String      // ex: "08:00-10:00"
  typeConflit     String      // "Salle" ou "Professeur"
  
  // Relations
  id_professeur   Int?
  professeur      Professeur? @relation(fields: [id_professeur], references: [id], onDelete: Cascade)
  
  id_salle        Int?
  salle           Salle?      @relation(fields: [id_salle], references: [id], onDelete: Cascade)
  
  createdAt       DateTime    @default(now())
}

// Cours planifiés (affectations)
model AffectationCours {
  id              Int        @id @default(autoincrement())
  date            DateTime
  plageHoraire    String     // ex: "08:00-10:00"
  
  // Relations
  id_cours        Int
  cours           Cours      @relation(fields: [id_cours], references: [id])
  
  id_professeur   Int?
  professeur      Professeur? @relation(fields: [id_professeur], references: [id])
  
  id_salle        Int
  salle           Salle      @relation(fields: [id_salle], references: [id])
  
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}