generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String
  createdAt DateTime @default(now())
}

model Cours {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  nom       String
  duree     Int
  programme String
  etape     String
  typeSalle String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Salle {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  type      String
  capacite  Int
  createdAt DateTime @default(now())
}

model Professeur {
  id         Int      @id @default(autoincrement())
  matricule  String   @unique
  nom        String
  prenom     String
  specialite String
  createdAt  DateTime @default(now())
}
