<section class="page-section">
    <div class="top-action-row">
        <h1>Gestion des Salles</h1>
        <div class="right-actions">
            <input type="text" class="search-input" id="search-salles" placeholder="Rechercher..." />
            <button class="btn btn-vert" id="btn-toggle-form">+ Ajouter une Salle</button>
        </div>
    </div>

    <div class="form-card hidden" id="form-card">
        <form id="form-salle">
            <div class="form-row">
                <div class="form-group">
                    <label for="code">Code de la Salle</label>
                    <input type="text" id="code" placeholder="Ex: A-101" required />
                </div>
                <div class="form-group">
                    <label for="type">Type</label>
                    <select id="type" required>
                        <option value="">-- Choisir --</option>
                        <option value="Classe">Classe</option>
                        <option value="Labo">Labo</option>
                        <option value="Amphi">Amphi</option>
                        <option value="Informatique">Informatique</option>
                    </select>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label for="capacite">Capacité</label>
                    <input type="number" id="capacite" placeholder="Ex: 30" required />
                </div>
            </div>
            <button type="submit" class="btn btn-ajouter">+ Ajouter la salle</button>
        </form>
    </div>

    <div id="msg-salle" class="message"></div>

    <div class="table-container">
        <table id="table-salles">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Type</th>
                    <th>Capacité</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</section>

<!-- Modale modification salle -->
<div id="modale-modifier" class="modale-overlay" style="display:none;">
    <div class="modale-contenu">
        <h3>Modifier la salle</h3>
        <div class="modale-champ">
            <label>Nom de la salle</label>
            <input type="text" id="mod-code" />
        </div>
        <div class="modale-champ">
            <label>Type</label>
            <input type="text" id="mod-type" />
        </div>
        <div class="modale-champ">
            <label>Capacité</label>
            <input type="number" id="mod-capacite" />
        </div>
        <div class="modale-actions">
            <button class="btn btn-modifier" id="mod-valider">Valider</button>
            <button class="btn btn-supprimer" id="mod-annuler">Annuler</button>
        </div>
    </div>
</div>
