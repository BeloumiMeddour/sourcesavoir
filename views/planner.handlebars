<section class="page-section">
    <div class="top-action-row">
        <h1>Emploi du Temps</h1>
        <div class="right-actions">
            <span>Salle</span>
            <select id="filtre-salle">
                <option value="">Toutes</option>
            </select>
            <span>Professeur</span>
            <select id="filtre-prof">
                <option value="">Tous</option>
            </select>
        </div>
    </div>

    <div class="planning-controls">
        <div class="vue-toggle">
            <button class="btn btn-vue active" id="btn-vue-semaine">Semaine</button>
            <button class="btn btn-vue" id="btn-vue-mois">Mois</button>
        </div>
        <div id="ctrl-semaine">
            <select id="select-semaine"></select>
        </div>
        <div id="ctrl-mois" style="display:none;">
            <button class="btn btn-nav" id="btn-mois-prec">&lt;</button>
            <span id="label-mois"></span>
            <button class="btn btn-nav" id="btn-mois-suiv">&gt;</button>
        </div>
        <span class="semaine-label" id="label-semaine"></span>
        <div>
            <button class="btn btn-bleu" id="btn-exporter">Exporter</button>
        </div>
    </div>

    <div class="planning-card">
        <div class="planning-grid" id="planning-grid">
            <!-- Rempli par JS -->
        </div>

        <div class="planning-legende">
            <div class="legende-item">
                <div class="legende-dot vert"></div>
                Réservation
            </div>
            <div class="legende-item">
                <div class="legende-dot rouge"></div>
                Conflit
            </div>
        </div>
    </div>
</section>
