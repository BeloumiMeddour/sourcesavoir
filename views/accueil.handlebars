<section class="page-section accueil">
    <h1>Bienvenue sur Planify</h1>
    <p>Gestion des horaires du Collège La Cité</p>

    {{#if user_email}}
        <div class="user-info">Connecté : <strong>{{user_email}}</strong></div>

        <div class="accueil-grid">
            <a href="/cours" class="accueil-card">
                <div class="card-icon">&#128218;</div>
                <div class="card-title">Cours</div>
                <div class="card-desc">Gérer les cours du programme</div>
            </a>
            <a href="/professeurs" class="accueil-card">
                <div class="card-icon">&#128100;</div>
                <div class="card-title">Professeurs</div>
                <div class="card-desc">Gérer les enseignants</div>
            </a>
            <a href="/salles" class="accueil-card">
                <div class="card-icon">&#127970;</div>
                <div class="card-title">Salles</div>
                <div class="card-desc">Gérer les locaux</div>
            </a>
            <a href="/affectations" class="accueil-card">
                <div class="card-icon">&#128197;</div>
                <div class="card-title">Affectations</div>
                <div class="card-desc">Planifier les horaires</div>
            </a>
        </div>
    {{else}}
        <p>Veuillez vous connecter pour accéder aux fonctionnalités.</p>
        <div class="accueil-non-connecte">
            <a href="/connexion">Se connecter</a>
        </div>
    {{/if}}
</section>