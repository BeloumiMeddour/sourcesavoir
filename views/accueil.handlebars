<section class="page-section accueil">
{{#if user_email}}

    <!-- KPI -->
    <div class="kpi-strip">
        <div class="kpi-chip">
            <div class="kpi-val" id="stat-cours">–</div>
            <div class="kpi-lbl">Cours</div>
        </div>
        <span class="kpi-sep"></span>
        <div class="kpi-chip">
            <div class="kpi-val" id="stat-profs">–</div>
            <div class="kpi-lbl">Professeurs</div>
        </div>
        <span class="kpi-sep"></span>
        <div class="kpi-chip">
            <div class="kpi-val" id="stat-salles">–</div>
            <div class="kpi-lbl">Salles</div>
        </div>
        <span class="kpi-sep"></span>
        <div class="kpi-chip kpi-chip-accent">
            <div class="kpi-val" id="stat-affectations">–</div>
            <div class="kpi-lbl">Affectations</div>
        </div>
    </div>

    <!-- Heatmap + panneau droit -->
    <div class="dash-main">

        <div class="dash-card heatmap-card">
            <div class="dash-card-header">
                <div class="dash-card-title">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    Occupation des créneaux
                </div>
                <div class="heatmap-legend">
                    <span class="hl-cell hl-0"></span>
                    <span class="hl-cell hl-1"></span>
                    <span class="hl-cell hl-2"></span>
                    <span class="hl-cell hl-3"></span>
                    <span class="hl-cell hl-4"></span>
                    <span class="hl-label">Faible → Élevé</span>
                </div>
            </div>
            <div class="heatmap-wrap">
                <div class="schedule-grid" id="schedule-grid"></div>
            </div>
        </div>

        <div class="dash-side">

            <div class="dash-card taux-card">
                <div class="dash-card-title">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    Complétion du planning
                </div>
                <div class="taux-body">
                    <div class="taux-ring">
                        <canvas id="chartTaux" width="120" height="120"></canvas>
                        <div class="taux-center">
                            <span id="taux-pct">–</span><em>%</em>
                        </div>
                    </div>
                    <div class="taux-stats">
                        <div class="taux-stat">
                            <span class="ts-dot ts-green"></span>
                            <span id="taux-aff">–</span> affectés
                        </div>
                        <div class="taux-stat">
                            <span class="ts-dot ts-grey"></span>
                            <span id="taux-lib">–</span> libres
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Top profs + Top salles -->
    <div class="dash-bottom">

        <div class="dash-card">
            <div class="dash-card-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                Charge des professeurs
            </div>
            <div class="top-list" id="top-profs">
                <p class="tl-empty">Chargement…</p>
            </div>
        </div>

        <div class="dash-card">
            <div class="dash-card-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
                Occupation des salles
            </div>
            <div class="top-list" id="top-salles">
                <p class="tl-empty">Chargement…</p>
            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="./js/dashboard.js"></script>

{{else}}
    <!-- Hero Section avec vidéo -->
    <div class="hero-section">
        <div class="hero-overlay"></div>
        <div class="hero-video-wrap">
            <video autoplay muted loop playsinline id="hero-video">
                <source src="/assets/hero-video.mp4" type="video/mp4" />
            </video>
        </div>
        <div class="hero-content">
            <div class="hero-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                Accès restreint
            </div>
            <h1 class="hero-title">Bienvenue sur <span>EPlanify</span></h1>
            <p class="hero-subtitle">L'application de gestion des horaires du Collège La Cité.<br/>Planifiez, organisez et optimisez les emplois du temps en toute simplicité.</p>
            <div class="hero-actions">
                <a href="/connexion" class="hero-btn hero-btn-primary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                    Se connecter
                </a>
                <a href="/inscription" class="hero-btn hero-btn-secondary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                    Créer un compte
                </a>
            </div>
        </div>
        <!-- Scroll indicator -->
        <div class="scroll-indicator">
            <div class="scroll-arrow"></div>
        </div>
    </div>

    <!-- Stats Counter Section -->
    <div class="stats-section">
        <div class="stats-container">
            <div class="stat-item" data-target="50" data-suffix="+">
                <div class="stat-number">0</div>
                <div class="stat-label">Programmes offerts</div>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item" data-target="200" data-suffix="+">
                <div class="stat-number">0</div>
                <div class="stat-label">Professeurs</div>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item" data-target="100" data-suffix="+">
                <div class="stat-number">0</div>
                <div class="stat-label">Salles de cours</div>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item" data-target="5000" data-suffix="+">
                <div class="stat-number">0</div>
                <div class="stat-label">Étudiants</div>
            </div>
        </div>
    </div>

    <!-- Features Section -->
    <div class="features-section">
        <div class="section-header">
            <h2 class="section-title">Pourquoi <span>EPlanify</span> ?</h2>
            <p class="section-subtitle">Une solution complète pour la gestion des emplois du temps</p>
        </div>
        <div class="features-grid">
            <div class="feature-card" data-aos>
                <div class="feature-icon feature-icon-blue">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </div>
                <h3>Planification intelligente</h3>
                <p>Créez et gérez les emplois du temps par semestre avec détection automatique des conflits.</p>
            </div>
            <div class="feature-card" data-aos>
                <div class="feature-icon feature-icon-green">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <h3>Gestion des ressources</h3>
                <p>Professeurs, salles et disponibilités centralisés pour une attribution optimale.</p>
            </div>
            <div class="feature-card" data-aos>
                <div class="feature-icon feature-icon-red">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                </div>
                <h3>Vue hebdomadaire</h3>
                <p>Visualisez l'emploi du temps complet avec filtres par programme, professeur ou salle.</p>
            </div>
            <div class="feature-card" data-aos>
                <div class="feature-icon feature-icon-purple">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <h3>Sécurisé & fiable</h3>
                <p>Accès contrôlé par rôles avec validation administrateur pour une sécurité optimale.</p>
            </div>
        </div>
    </div>

    <!-- Bottom CTA -->
    <div class="cta-section">
        <div class="cta-content">
            <img src="/assets/logo-lacite.png" alt="La Cité" class="cta-logo" onerror="this.style.display='none'" />
            <h2>Prêt à optimiser vos horaires ?</h2>
            <p>Rejoignez EPlanify et simplifiez la gestion de vos emplois du temps dès maintenant.</p>
            <a href="/inscription" class="hero-btn hero-btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                Commencer maintenant
            </a>
        </div>
    </div>
{{/if}}
</section>
