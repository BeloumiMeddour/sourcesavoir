<section class="page-section accueil-dashboard">
    <div class="dashboard-hero">
        <div>
            <h1>Bienvenue sur Planify</h1>
            <p class="dashboard-subtitle">Vue d’ensemble de l’activité de planification</p>
        </div>

        {{#if user_email}}
            <div class="user-badge">Connecté : <strong>{{user_email}}</strong></div>
        {{/if}}
    </div>

    {{#if user_email}}
        <div class="kpi-grid">
            <article class="kpi-card">
                <div class="kpi-head">
                    <div class="kpi-icon kpi-blue">📚</div>
                </div>
                <div class="kpi-value" id="kpi-cours">0</div>
                <div class="kpi-label">Cours planifiés</div>
            </article>

            <article class="kpi-card">
                <div class="kpi-head">
                    <div class="kpi-icon kpi-purple">📅</div>
                </div>
                <div class="kpi-value" id="kpi-affectations">0</div>
                <div class="kpi-label">Affectations</div>
            </article>

            <article class="kpi-card">
                <div class="kpi-head">
                    <div class="kpi-icon kpi-green">👨‍🏫</div>
                </div>
                <div class="kpi-value" id="kpi-prof-occupation">0%</div>
                <div class="kpi-label">Occupation des professeurs</div>
            </article>

            <article class="kpi-card">
                <div class="kpi-head">
                    <div class="kpi-icon kpi-orange">🏫</div>
                </div>
                <div class="kpi-value" id="kpi-salles">0%</div>
                <div class="kpi-label">Salles utilisées</div>
            </article>
        </div>

        <div class="dashboard-grid">
            <section class="dashboard-card dashboard-card-large">
                <div class="card-header">
                    <h2>Affectations par jour</h2>
                    <p>Répartition hebdomadaire</p>
                </div>
                <div class="bar-chart" id="chart-jours"></div>
            </section>

            <section class="dashboard-card">
                <div class="card-header">
                    <h2>Répartition des cours</h2>
                    <p>Par programme</p>
                </div>
                <div class="donut-wrap">
                    <div class="donut-chart" id="donut-programmes">
                        <div class="donut-center">
                            <span id="donut-total">0</span>
                            <small>cours</small>
                        </div>
                    </div>
                    <div class="legend-list" id="legend-programmes"></div>
                </div>
            </section>

            <section class="dashboard-card dashboard-card-wide">
                <div class="card-header">
                    <h2>Professeurs les plus sollicités</h2>
                    <p>Selon le nombre d’affectations</p>
                </div>
                <div class="prof-list" id="prof-list"></div>
            </section>
        </div>
    {{else}}
        <p>Veuillez vous connecter pour accéder au tableau de bord.</p>
        <div class="accueil-non-connecte">
            <a href="/connexion">Se connecter</a>
        </div>
    {{/if}}
</section>

<link rel="stylesheet" href="/css/accueil.css">
<script src="/js/accueil.js"></script>