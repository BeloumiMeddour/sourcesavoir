<!-- Top bar -->
<div class="topbar">
    <div class="topbar-left">
        <button class="hamburger-btn" id="btn-hamburger" aria-label="Menu">
            <span></span><span></span><span></span>
        </button>
    </div>
    <div class="topbar-right">
        {{#if user_email}}
            <span class="topbar-email">{{user_email}}</span>
            <button id="btn-deconnexion">Déconnexion</button>
        {{else}}
            <a href="/connexion" class="topbar-link">Se connecter</a>
        {{/if}}
    </div>
</div>

<!-- Sidebar permanente -->
<aside class="sidebar">
    <div class="sidebar-header">
        <img src="/assets/logoLacite.jpg" alt="La Cité" />
        <span class="sidebar-header-title">EPlanify</span>
    </div>
    <nav class="sidebar-nav">
        {{#if is_admin}}
            <div class="sidebar-role">Administrateur</div>
        {{/if}}

        {{#unless user_email}}
            <a href="/connexion" class="sidebar-link">
                <span class="sidebar-icon">&#128274;</span>
                S'authentifier
            </a>
            <a href="/inscription" class="sidebar-link">
                <span class="sidebar-icon">&#9997;</span>
                Inscription
            </a>
        {{/unless}}

        {{#if is_admin}}
            <a href="/admin" class="sidebar-link">
                <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/><path d="M12 1v22M4.22 4.22l15.56 15.56M4.22 19.78L19.78 4.22"/></svg>
                Gestion des Comptes
            </a>
        {{/if}}

        {{#if user_email}}
            <a href="/" class="sidebar-link">
                <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                Tableau de bord
            </a>
            <a href="/salles" class="sidebar-link">
                <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 3v18"/></svg>
                Gestion des Salles
            </a>
            <a href="/professeurs" class="sidebar-link">
                <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                Gestion des Professeurs
            </a>
            <a href="/cours" class="sidebar-link">
                <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                Gestion des Cours
            </a>
            <a href="/affectations" class="sidebar-link">
                <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                Gestion des Affectations
            </a>
            {{#if peut_gerer_scolaire}}
                <a href="/eleves" class="sidebar-link">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                    Gestion des Élèves
                </a>
            {{/if}}
            <a href="/gerer-semestres" class="sidebar-link">
                <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                Semestres & Jours fériés
            </a>
            <a href="/planner" class="sidebar-link">
                <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/><rect x="3" y="4" width="18" height="18" rx="2"/></svg>
                Planner
            </a>
        {{/if}}
    </nav>

    <div class="sidebar-footer">
        &copy; 2026 EPlanify &ndash; La Cité
    </div>
</aside>

<script>
    // Marquer le lien actif dans la sidebar
    document.querySelectorAll('.sidebar-link').forEach(function(link) {
        if (link.getAttribute('href') === window.location.pathname) {
            link.classList.add('active');
        }
    });

    // Sidebar toggle pour mobile
    (function() {
        var hamburger = document.getElementById('btn-hamburger');
        var sidebar = document.querySelector('.sidebar');

        // Créer l'overlay
        var overlay = document.createElement('div');
        overlay.className = 'sidebar-overlay';
        document.body.appendChild(overlay);

        function toggleSidebar() {
            sidebar.classList.toggle('sidebar-open');
            overlay.classList.toggle('sidebar-overlay-visible');
            hamburger.classList.toggle('hamburger-active');
        }

        function closeSidebar() {
            sidebar.classList.remove('sidebar-open');
            overlay.classList.remove('sidebar-overlay-visible');
            hamburger.classList.remove('hamburger-active');
        }

        hamburger.addEventListener('click', toggleSidebar);
        overlay.addEventListener('click', closeSidebar);

        // Fermer au redimensionnement si on repasse en desktop
        window.addEventListener('resize', function() {
            if (window.innerWidth > 768) {
                closeSidebar();
            }
        });
    })();
</script>
