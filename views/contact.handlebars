<section class="page-section">
    <h1><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>Contactez-nous</h1>
    
    <div class="contact-grid">
        <!-- Formulaire -->
        <div class="contact-card">
            <div class="contact-card-header">
                <div class="contact-card-icon contact-icon-green">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </div>
                <h2>Envoyer un message</h2>
            </div>
            <form id="contact-form">
                <div class="form-group">
                    <label for="name-input">Nom complet</label>
                    <input type="text" id="name-input" placeholder="Votre nom" required />
                </div>
                <div class="form-group">
                    <label for="email-input">Adresse email</label>
                    <input type="email" id="email-input" placeholder="Votre email" required />
                </div>
                <div class="form-group">
                    <label for="message-input">Message</label>
                    <textarea id="message-input" placeholder="Décrivez votre demande..." rows="5" required></textarea>
                </div>
                <button type="submit" class="btn btn-vert" style="width:100%;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;display:inline;vertical-align:middle;margin-right:6px;"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                    Envoyer
                </button>
            </form>
        </div>

        <!-- Informations -->
        <div class="contact-info-side">
            <div class="contact-card contact-info-card">
                <div class="contact-card-icon contact-icon-blue">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <h3>Adresse</h3>
                <p>801 Promenade de l'Aviation<br/>Ottawa, ON K1K 4R3</p>
            </div>
            <div class="contact-card contact-info-card">
                <div class="contact-card-icon contact-icon-amber">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </div>
                <h3>Téléphone</h3>
                <p>(613) 742-2483</p>
            </div>
            <div class="contact-card contact-info-card">
                <div class="contact-card-icon contact-icon-red">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                </div>
                <h3>Site web</h3>
                <p><a href="https://www.collegelacite.ca" target="_blank">www.collegelacite.ca</a></p>
            </div>
        </div>
    </div>
</section>
